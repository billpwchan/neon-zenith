# Caddy site block (copy to deploy/local/gateway.caddy and set your hostname). The site is served from
# /srv/sites/neon-zenith/current, which deploy/deploy.sh swaps atomically on each release; /healthz answers without
# touching the files.
zenith.example.com {
	root * /srv/sites/neon-zenith/current
	encode zstd gzip
	# One JSON line per page view, so visits can be counted by the ?ref= in the uri. Addresses are dropped:
	# the peer, client and forwarded IPs and the headers that carry them never reach the log.
	log neon-zenith {
		output stdout
		format filter {
			wrap json
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers>Cf-Connecting-Ip delete
			request>headers>Cf-Connecting-Ipv6 delete
			request>headers>Cf-Pseudo-Ipv4 delete
			request>headers>True-Client-Ip delete
			request>headers>X-Forwarded-For delete
			request>headers>X-Real-Ip delete
			request>headers>Forwarded delete
			request>headers>Cookie delete
			request>tls delete
			resp_headers delete
		}
	}
	@notpage not path / /index.html
	log_skip @notpage
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
	# Vite fingerprints everything under /assets. The rest (models, textures, the district and its light) keeps
	# its name across releases while the bundle that reads it changes, so it is revalidated on every load: a 304
	# when unchanged (deploy.sh keeps the files' mtimes, which the ETag is built from).
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@named not path /assets/*
	header @named Cache-Control "no-cache"
	handle /healthz {
		respond "ok" 200
	}
	handle {
		file_server
	}
}
